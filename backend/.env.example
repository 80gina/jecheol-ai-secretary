# ---- 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 Git 에 올리지 마세요. ----

# OpenAI
OPENAI_API_KEY=sk-여기에_본인_키
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=600

# Firebase (아래 셋 중 하나만 채우면 됩니다)
#  - 로컬 개발: 서비스 계정 키 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#  - Render 배포: 키 JSON 을 base64 로 인코딩한 한 줄 문자열 (줄바꿈 문제가 없어 안전)
#    만드는 법(macOS/Linux): base64 -w0 serviceAccountKey.json
#    만드는 법(Windows PS) : [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_B64=
#  - 또는 JSON 원문 그대로
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS: 프론트엔드 주소를 콤마로 구분해 나열
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://내프로젝트.vercel.app

# 개발 편의: Firebase 설정 전에 API 흐름만 확인할 때 true. 제출/배포 시에는 false!
USE_MEMORY_DB=false

APP_ENV=local
